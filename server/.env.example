# MongoDB connection string (use MongoDB Atlas URI for production)
MONGO_URI=mongodb://127.0.0.1:27017/medijourney

# JWT secret key
JWT_SECRET=your_super_secure_jwt_secret_here

# Port (Vercel ignores this, it's for local dev)
PORT=5000

# Frontend URL for CORS (set to your Vercel deployment URL)
CLIENT_URL=http://localhost:5173
